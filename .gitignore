# ==========================================
# Quarto & Markdown Kern-Dateien
# ==========================================
# Temporärer Cache und Render-Artefakte von Quarto
/.quarto/

## Rproj
*.RProj
# Lokale Konfigurationsdateien (enthalten oft nutzerspezifische Pfade)
_quarto.yml.local

# Generierte Ausgabe-Verzeichnisse (nur ignorieren, wenn das Deployment über CI/CD läuft)
# Falls Sie GitHub Pages direkt aus einem lokalen Ordner bedienen, diese Zeilen auskommentieren!
/_site/
/_book/

# Generierte Intermediates / Zwischenschritte aus dem Render-Prozess
*_files/
*_cache/
/cache/
*typ
*rmarkdown

# Große Daten
*.tsv
*.csv

# ==========================================
# R & RStudio (falls genutzt)
# ==========================================
.Rproj.user
.Rhistory
.RData
.Ruserdata
*-Ex.R
/*.tar.gz
/*.Rcheck/
.httr-oauth
# Knitr/RMarkdown spezifischer Cache
*.utf8.md
*.knit.md

# ==========================================
# Python & Virtuelle Umgebungen (falls genutzt)
# ==========================================
env/
.env/
venv/
.venv/
__pycache__/
*.pyc

# ==========================================
# Betriebssystem-Spezifisches
# ==========================================
.DS_Store
Thumbs.db
